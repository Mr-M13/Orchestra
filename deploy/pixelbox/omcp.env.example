# Install as /etc/orchestra/omcp.env, owner hamed, mode 0600.
# These values assert that the dedicated tunnel/app access boundary was
# verified by the operator.  They are not per-request ChatGPT authentication.
OMCP_TUNNEL_AUTHENTICATED=1
OMCP_AUTHENTICATED_CALLER=orchestra:dedicated-workspace
PATH=/usr/local/bin:/usr/bin:/bin
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
# Set only when the reviewed OpenCode CLI is installed at a non-default path.
# OMCP_OPENCODE_CLI=/opt/orchestra/bin/opencode-cli

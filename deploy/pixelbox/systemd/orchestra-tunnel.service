[Unit]
Description=OpenAI Secure MCP Tunnel for Orchestra (PixelBox)
Documentation=file:/opt/orchestra/docs/PIXELBOX-MIGRATION.md
After=network-online.target orchestra-omcp.service
Wants=network-online.target
Requires=orchestra-omcp.service
# Keep the separate read-only Bridge tunnel alive until the cutover approval.
# This unit owns only the dedicated OMCP tunnel profile.  The stdio command in
# that profile is omcp.mcp_proxy, which connects to the persistent coordinator.

[Service]
Type=simple
User=hamed
Group=hamed
WorkingDirectory=/opt/orchestra
EnvironmentFile=/etc/orchestra/tunnel.env
ExecStart=/usr/local/bin/tunnel-client run --profile pixelbox
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hamed/.config/tunnel-client
ReadWritePaths=/home/hamed/.local/share/tunnel-client
ReadWritePaths=/home/hamed/.local/state/tunnel-client
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target

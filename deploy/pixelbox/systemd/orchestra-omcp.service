[Unit]
Description=Orchestra OMCP coordinator (PixelBox)
Documentation=file:/opt/orchestra/current/docs/PIXELBOX-MIGRATION.md
After=network-online.target
Wants=network-online.target
# These units do not manage or restart Tailscale Serve or the Nextcloud stack.
Conflicts=shutdown.target

[Service]
Type=simple
User=hamed
Group=hamed
SupplementaryGroups=orchestra-mcp
RuntimeDirectory=orchestra
RuntimeDirectoryMode=0710
WorkingDirectory=/opt/orchestra/current
EnvironmentFile=/etc/orchestra/omcp.env
ExecStartPre=/usr/bin/test -r /etc/orchestra/omcp.json
ExecStart=/usr/bin/python3 -m omcp.server --config /etc/orchestra/omcp.json --socket /run/orchestra/omcp.sock --socket-group orchestra-mcp
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
# Task runners use independent sessions and are reconciled by PID after coordinator restart.
# Kill only the coordinator process so an in-flight task survives a release activation.
KillMode=process
UMask=0077

# Defence in depth.  Worker worktrees and owner state are the only writable
# locations; the repository checkout is read-write only because Git creates
# worktree metadata there.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hamed/orchestra-migration/state
ReadWritePaths=-/home/hamed/orchestra-migration/checkout
ReadWritePaths=-/home/hamed/.codex
ReadWritePaths=-/home/hamed/.codex-ina
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target

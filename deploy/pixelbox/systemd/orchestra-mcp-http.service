[Unit]
Description=Orchestra loopback HTTP MCP gateway
After=orchestra-omcp.service
Requires=orchestra-omcp.service
Conflicts=shutdown.target

[Service]
Type=simple
WorkingDirectory=/opt/orchestra/current
User=orchestra-mcp-http
Group=orchestra-mcp
EnvironmentFile=/etc/orchestra/mcp-http.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/orchestra/current
# Exercise the same identity and module path used by the service.
ExecStartPre=/usr/bin/python3 -c "import omcp.http_gateway"
ExecStartPre=/usr/bin/test -r /etc/orchestra/mcp-http.env
ExecStartPre=/usr/bin/test -S /run/orchestra/omcp.sock
ExecStart=/usr/bin/python3 -m omcp.http_gateway --socket /run/orchestra/omcp.sock --socket-owner hamed --socket-group orchestra-mcp --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=control-group
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
# systemd >= 249: the gateway may bind only its reviewed loopback listener.
SocketBindDeny=any
SocketBindAllow=inet:8090

[Install]
WantedBy=multi-user.target

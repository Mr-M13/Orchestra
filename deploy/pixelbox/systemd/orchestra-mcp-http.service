[Unit]
Description=Orchestra loopback HTTP MCP gateway
After=orchestra-omcp.service
Requires=orchestra-omcp.service
[Service]
User=orchestra-mcp-http
Group=orchestra-mcp-http
EnvironmentFile=/etc/orchestra/mcp-http.env
ExecStart=/usr/bin/python3 -m omcp.http_gateway --socket /home/hamed/orchestra-migration/state/mcp.sock --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/home/hamed/orchestra-migration/state/mcp.sock
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET
[Install]
WantedBy=multi-user.target

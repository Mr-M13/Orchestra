[Unit]
Description=Orchestra loopback HTTP MCP gateway
After=orchestra-omcp.service
Requires=orchestra-omcp.service
[Service]
User=hamed
Group=hamed
EnvironmentFile=/etc/orchestra/mcp-http.env
ExecStart=/usr/bin/python3 -m omcp.http_gateway --socket /home/hamed/orchestra-migration/state/mcp.sock --host 127.0.0.1 --port 8090
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hamed/orchestra-migration/state
RestrictAddressFamilies=AF_UNIX AF_INET
[Install]
WantedBy=multi-user.target

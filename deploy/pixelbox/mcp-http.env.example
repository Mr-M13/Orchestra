# Owner-managed gateway authentication secret. Installer sets this file to
# owner orchestra-mcp-http, group orchestra-mcp, mode 0600 without replacing an
# existing value. Generate at least 32 characters from [A-Za-z0-9._~+/=-]
# locally, for example:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Never commit the filled file or print the token in logs.
ORCHESTRA_MCP_HTTP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
